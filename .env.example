# ── LLM provider（二选一即可；两个都填时用 LLM_PROVIDER 指定）─────────────
# 可选值：deepseek | anthropic。留空时自动选用已配置 Key 的那个。
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容接口，base URL 默认 https://api.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选，默认 deepseek-flash；也可用 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# 可选，仅在需要自定义网关时填写
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Agent 参数 ──────────────────────────────────────────────────────────
# LangGraph 验证循环的最大轮次，默认 2
AGENT_MAX_VALIDATION_LOOPS=2
